local function handleRoundReset()
    if State.isAnchoredInLobby and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.Anchored = false
    end
    State.isAnchoredInLobby = false
    table.clear(State.collectedCoins)
    State.wasStoppedInLobby = false
    State.autoDisableFarmCurrentRound = false
    State.bagFullTriggered = false

    State.roundTimeLeft = 180
    State.roundTimerActive = false
    State.murdererDetectedForTimer = false

    State.RoleData = {}
    State.CachedPerks = {}
    State.roundCoins = 0
    State.lastCoinIndex = nil
    clearAllTargetFx()

    clearAllESP()
    stopFlying()
    State.activeCoins = {}
    State.activeCoinsSet = {}

    local stw = getFeature("Shoot Through Walls")
    if stw then getgenv().PistolAimConfig.Active = stw.Enabled end
    local ka = getFeature("Kill Aura")
    if ka then getgenv().AimbotConfig.Active = ka.Enabled end
    local gunESP = getFeature("Gun ESP")
    if gunESP then getgenv().GunESPEnabled = gunESP.Enabled end

    if updateGunESP then updateGunESP() end
    if updateRolesESP then updateRolesESP() end
end

-- подключение к ремоутам асинхронное: долгие ожидания не висят на запуске
task.spawn(function()
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
if Remotes then
    local Gameplay = Remotes:WaitForChild("Gameplay", 30)
    if Gameplay then
        local RoundStartRemote = Gameplay:WaitForChild("RoundStart", 15)
        if RoundStartRemote then RoundStartRemote.OnClientEvent:Connect(handleRoundReset) end

        -- Очистка ролей при окончании раунда (чтобы роли прошлого раунда не оставались в лобби)
        local RoundEndRemote = Gameplay:FindFirstChild("RoundEnd") or Gameplay:FindFirstChild("RoundEndFade") or Gameplay:FindFirstChild("Fade")
        if RoundEndRemote then
            RoundEndRemote.OnClientEvent:Connect(function()
                State.RoleData = {}
    State.CachedPerks = {}
            end)
        end

        -- при повторных запусках скрипта слушатели не должны складываться
        local function bindOnce(remote, handler)
            -- снимаем слушатели прошлых запусков: у экзекюторных функций пустой source
            for _, conn in ipairs(getconnections(remote.OnClientEvent)) do
                local f = conn.Function
                if f then
                    local okInfo, info = pcall(debug.getinfo, f)
                    -- у игровых скриптов source начинается с "=", у экзекюторных ("@" и т.п.) - нет
                    if okInfo and info and not (info.source or ""):match("^=") then
                        pcall(function() conn:Disconnect() end)
                    end
                end
            end
            getgenv()["CelestialConn_" .. remote.Name] = remote.OnClientEvent:Connect(handler)
        end

        -- Роли всех игроков приходят отсюда: ESP и флинг читают их напрямую
        local PlayerDataChanged = Gameplay:WaitForChild("PlayerDataChanged", 5)
        if PlayerDataChanged then
            bindOnce(PlayerDataChanged, function(data)
                if typeof(data) == "table" then
                    -- Мерджим роли, не затирая известных маньяка/шерифа если раунд идет
                    if not State.RoleData then State.RoleData = {}
    State.CachedPerks = {} end
                    if not State.CachedPerks then State.CachedPerks = {} end
                    for pName, pData in pairs(data) do
                        if typeof(pData) == "table" then
                            local perkFound = pData.Perk or pData.perk or pData.PerkName or pData.Power or pData.Ability
                            if perkFound then State.CachedPerks[pName] = perkFound end
                            local existing = State.RoleData[pName]
                            if not existing then
                                State.RoleData[pName] = pData
                            else
                                -- Если сервер присылает Innocent для уже известного маньяка/шерифа,
                                -- проверяем: если игрок жив, не понижаем роль до Innocent преждевременно
                                if (existing.Role == "Murderer" or existing.Role == "Sheriff") and pData.Role == "Innocent" and not pData.Dead then
                                    existing.Dead = pData.Dead
                                    -- сохраняем роль маньяка/шерифа
                                else
                                    State.RoleData[pName] = pData
                                end
                            end
                        else
                            State.RoleData[pName] = pData
                        end
                    end
                    -- событие летит на любое изменение данных:
                    -- пересбор списка не чаще раза в секунду
                    if not State.roleRefreshPending then
                        State.roleRefreshPending = true
                        task.delay(1, function()
                            State.roleRefreshPending = false
                            if State.refreshPlayerList then pcall(State.refreshPlayerList) end
                        end)
                    end
                end
            end)

            -- мгновенные роли на первом запуске: запрашиваем текущие данные сами
            local GetCurrentData = Gameplay:FindFirstChild("GetCurrentPlayerData")
            if GetCurrentData then
                task.spawn(function()
                    local okData, data = pcall(function() return GetCurrentData:InvokeServer() end)
                    if okData and typeof(data) == "table" then
                        State.RoleData = data
                        if State.refreshPlayerList then pcall(State.refreshPlayerList) end
                    end
                end)
            end
        end

        -- Монеты: игра шлёт каждый сбор ДВАЖДЫ - дедуп по индексу монеты
        local CoinCollected = Gameplay:WaitForChild("CoinCollected", 5)
        if CoinCollected then
            bindOnce(CoinCollected, function(kind, coinIndex, bagCap, info)
                if typeof(coinIndex) == "number" then
                    if coinIndex == State.lastCoinIndex then return end
                    State.lastCoinIndex = coinIndex
                end
                local amount = 1
                if typeof(info) == "table" and typeof(info.Value) == "number" then
                    amount = info.Value
                end
                State.roundCoins = State.roundCoins + amount
                State.sessionCoins = State.sessionCoins + amount
            end)
        end
    end
end
end)

