local function updateScreenBtnVisual(btn, feat)
    if not btn or not btn.Parent then return end
    local isEnabled = feat and feat.Enabled or false
    local targetBg = isEnabled and Theme.Accent or Color3.fromRGB(24, 24, 34)
    local targetStroke = isEnabled and Theme.Accent or Theme.CardBorder
    TweenService:Create(btn, TI.FAST, { BackgroundColor3 = targetBg }):Play()
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    local stroke = btn:FindFirstChildOfClass("UIStroke")
    if stroke then
        TweenService:Create(stroke, TI.FAST, { Color = targetStroke }):Play()
    end
end

local function toggleScreenButton(featName)
    if State.ScreenButtons[featName] then
        pcall(function() State.ScreenButtons[featName]:Destroy() end)
        State.ScreenButtons[featName] = nil
        return false
    end

    local feat = getFeature(featName)

    local btn = Instance.new("TextButton")
    btn.Name = "ScreenBtn_" .. featName:gsub("%s+", "")
    btn.Size = UDim2.new(0, 110, 0, 32)
    btn.Position = UDim2.new(0.85, -55, 0.35 + (#UI.BaseGui:GetChildren() % 6) * 0.08, 0)
    btn.BackgroundColor3 = (feat and feat.Enabled) and Theme.Accent or Color3.fromRGB(24, 24, 34)
    btn.Text = featName
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 85
    btn.Parent = UI.BaseGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local bStroke = Instance.new("UIStroke", btn)
    bStroke.Color = (feat and feat.Enabled) and Theme.Accent or Theme.CardBorder
    bStroke.Thickness = 1.3

    makeDraggable(btn, btn)

    local clickStart = Vector2.zero
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            clickStart = Vector2.new(inp.Position.X, inp.Position.Y)
        end
    end)

    btn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            local dist = (Vector2.new(inp.Position.X, inp.Position.Y) - clickStart).Magnitude
            if dist < 6 then
                if featName == "Silent Aim" or featName == "Aimbot V2" or featName == "Shoot Through Walls" then
                    -- Нажатие на экранную кнопку производит моментальный прицельный выстрел!
                    task.spawn(shootAtMurderer)
                    TweenService:Create(btn, TI.FAST, { BackgroundColor3 = Theme.Accent }):Play()
                    task.delay(0.15, function()
                        local currentFeat = getFeature(featName)
                        updateScreenBtnVisual(btn, currentFeat)
                    end)
                else
                    toggleFeatureByName(featName)
                    local currentFeat = getFeature(featName)
                    updateScreenBtnVisual(btn, currentFeat)
                end
            end
        end
    end)

    updateScreenBtnVisual(btn, feat)

    State.ScreenButtons[featName] = btn
    return true
end

