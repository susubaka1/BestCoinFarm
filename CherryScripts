local TARGET_GHOST_IMAGE = "rbxassetid://3570695787"

local function clearTargetFx(plr)
    local fx = State.TargetFx[plr]
    if fx then
        for _, item in ipairs(fx.Billboards) do
            if item.BB then item.BB:Destroy() end
        end
        State.TargetFx[plr] = nil
    end
end

local function clearAllTargetFx()
    for plr in pairs(State.TargetFx) do
        clearTargetFx(plr)
    end
end

local function ensureTargetFx(plr, kind)
    local fx = State.TargetFx[plr]
    if fx and fx.Kind == kind then return fx end
    clearTargetFx(plr)

    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    fx = { Kind = kind, Billboards = {} }

    if kind == "Murderer" then
        -- призраки: основной сгусток + след из затухающих копий
        local function makeGhost(size, transparency)
            local bb = Instance.new("BillboardGui")
            bb.Name = "CelestialTargetFx"
            bb.Adornee = root
            bb.Size = UDim2.fromScale(size, size)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 300
            local img = Instance.new("ImageLabel", bb)
            img.BackgroundTransparency = 1
            img.Size = UDim2.fromScale(1, 1)
            img.Image = TARGET_GHOST_IMAGE
            img.ImageColor3 = Color3.fromRGB(255, 255, 255)
            img.ImageTransparency = transparency
            bb.Parent = root
            return bb
        end
        for i = 1, 4 do
            local phase = (i - 1) * (math.pi / 2)
            local speed = 1.3 + i * 0.15
            local baseY = 0.2 + (i % 3) * 1.05
            table.insert(fx.Billboards, { BB = makeGhost(1.5, 0.2), BaseSize = 1.5, Phase = phase, Speed = speed, BaseY = baseY })
            for k = 1, 6 do
                table.insert(fx.Billboards, { BB = makeGhost(1.05, 0.35 + k * 0.09), BaseSize = 1.05, Phase = phase, Speed = speed, BaseY = baseY, TrailIdx = k })
            end
        end
    else
        -- ромб: скруглённые сегменты с обводкой, крупнее - чтоб было видно издалека
        local bb = Instance.new("BillboardGui")
        bb.Name = "CelestialTargetFx"
        bb.Adornee = root
        bb.Size = UDim2.fromScale(5.5, 5.5)
        bb.AlwaysOnTop = true
        bb.MaxDistance = 300
        local spin = Instance.new("Frame", bb)
        spin.BackgroundTransparency = 1
        spin.AnchorPoint = Vector2.new(0.5, 0.5)
        spin.Position = UDim2.fromScale(0.5, 0.5)
        spin.Size = UDim2.fromScale(0.62, 0.62)
        for i = 0, 3 do
            local ang = math.rad(45 + i * 90)
            local bar = Instance.new("Frame", spin)
            bar.AnchorPoint = Vector2.new(0.5, 0.5)
            bar.Size = UDim2.fromScale(0.34, 0.09)
            bar.Position = UDim2.fromScale(0.5 + math.cos(ang) * 0.52, 0.5 + math.sin(ang) * 0.52)
            bar.Rotation = math.deg(ang) + 90
            bar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            bar.BorderSizePixel = 0
            Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
            local barStroke = Instance.new("UIStroke", bar)
            barStroke.Color = Color3.fromRGB(20, 20, 30)
            barStroke.Thickness = 1.6
            barStroke.Transparency = 0.25
        end
        bb.Parent = root
        fx.Spin = spin
        table.insert(fx.Billboards, { BB = bb, BaseSize = 5.5 })
    end

    State.TargetFx[plr] = fx
    return fx
end

local function updateTargetESP()
    local feat = getFeature("Target ESP")
    local enabled = feat and feat.Enabled

    for plr in pairs(State.TargetFx) do
        if not plr.Parent then clearTargetFx(plr) end
    end

    if not enabled then
        if next(State.TargetFx) then clearAllTargetFx() end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local kind = nil
            local rd = State.RoleData[p.Name]
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and not (rd and rd.Dead) then
                local role = getPlayerRole(p)
                if role == "Murderer" then
                    kind = ((getSetting("Target ESP", "Эффект маньяка") or "Призраки") == "Призраки") and "Murderer" or "Sheriff"
                elseif role == "Sheriff" then
                    kind = ((getSetting("Target ESP", "Эффект шерифа") or "Ромб") == "Ромб") and "Sheriff" or "Murderer"
                end
            end
            local fx = State.TargetFx[p]
            if not kind then
                if fx then clearTargetFx(p) end
            elseif not fx or fx.Kind ~= kind then
                ensureTargetFx(p, kind)
            end
        end
    end
end

-- анимация: скорости и длина следа берутся из настроек Target ESP
RunService.RenderStepped:Connect(function()
    if not runAlive() or not next(State.TargetFx) then return end
    local now = os.clock()
    local ghostSpd = (getSetting("Target ESP", "Скорость призраков") or 15) / 15
    local trailLen = getSetting("Target ESP", "Длина следа") or 4
    local spinSpd = 140 * ((getSetting("Target ESP", "Скорость ромба") or 14) / 14)
    local sizeMul = (getSetting("Target ESP", "Размер") or 10) / 10
    for _, fx in pairs(State.TargetFx) do
        if fx.Spin and fx.Spin.Parent then
            fx.Spin.Rotation = (now * spinSpd) % 360
        end
        for _, g in ipairs(fx.Billboards) do
            if g.BaseSize then
                g.BB.Size = UDim2.fromScale(g.BaseSize * sizeMul, g.BaseSize * sizeMul)
            end
            if not g.Phase then continue end
            local a = now * ghostSpd * g.Speed + g.Phase
            if g.TrailIdx then
                if g.TrailIdx <= trailLen then
                    local ta = a - g.TrailIdx * 0.17
                    g.BB.Enabled = true
                    g.BB.StudsOffset = Vector3.new(math.cos(ta) * 2.1, g.BaseY + math.sin(now * 1.8 + g.Phase - g.TrailIdx * 0.12) * 0.55, math.sin(ta) * 2.1)
                else
                    g.BB.Enabled = false
                end
            else
                g.BB.Enabled = true
                g.BB.StudsOffset = Vector3.new(math.cos(a) * 2.1, g.BaseY + math.sin(now * 1.8 + g.Phase) * 0.55, math.sin(a) * 2.1)
            end
        end
    end
end)

