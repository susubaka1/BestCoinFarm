local function getThrowDirection(knife)
    if not knife then return nil end
    local td = knife:FindFirstChild("ThrowDirection")
    if td then
        if td:IsA("Vector3Value") then return td.Value end
        if typeof(td) == "Vector3" then return td end
    end
    if knife:IsA("BasePart") and knife.AssemblyLinearVelocity.Magnitude > 5 then
        return knife.AssemblyLinearVelocity.Unit
    end
    local part = knife:IsA("BasePart") and knife or knife:FindFirstChildWhichIsA("BasePart")
    if part then
        if part.AssemblyLinearVelocity.Magnitude > 5 then
            return part.AssemblyLinearVelocity.Unit
        end
        return part.CFrame.LookVector
    end
    return nil
end

local function checkKnifeThreat(myPos)
    local knife = workspace:FindFirstChild("ThrowingKnife") or workspace:FindFirstChild("FlyingKnife")
    if not knife or not knife:IsDescendantOf(workspace) then return nil end

    local knifePart = knife:IsA("BasePart") and knife or knife:FindFirstChildWhichIsA("BasePart")
    if not knifePart then return nil end

    local knifePos = knifePart.Position
    local dir = getThrowDirection(knife)
    if not dir or dir.Magnitude == 0 then dir = knifePart.CFrame.LookVector end
    dir = dir.Unit

    local toMe = myPos - knifePos
    local dist = toMe.Magnitude

    if dist < 65 then
        local forwardDist = toMe:Dot(dir)
        if forwardDist > 0 then
            local projection = knifePos + dir * forwardDist
            local perpDist = (myPos - projection).Magnitude

            if perpDist < 12 then
                local dodgeDir = (myPos - projection)
                if dodgeDir.Magnitude < 0.1 then
                    dodgeDir = dir:Cross(Vector3.new(0, 1, 0))
                    if dodgeDir.Magnitude < 0.1 then dodgeDir = Vector3.new(1, 0, 0) end
                end
                return dodgeDir.Unit, dist
            end
        end
    end
    return nil
end

