local function getGunPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart") or obj:FindFirstChildWhichIsA("BasePart", true)
end

instantPickup = function(gunObj)
    local autoPickupFeat = getFeature("Auto Pickup Gun")
    if not autoPickupFeat or not autoPickupFeat.Enabled then return end
    if not isPlayerAlive() or hasKnife(LocalPlayer) or hasGun(LocalPlayer) then return end

    task.spawn(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end

        local touchPart = getGunPart(gunObj)
        if not touchPart then
            local startWait = os.clock()
            while not touchPart and os.clock() - startWait < 0.2 do
                task.wait()
                touchPart = getGunPart(gunObj)
            end
        end

        if not touchPart then return end

        if firetouchinterest then
            for _ = 1, 3 do
                if not gunObj:IsDescendantOf(workspace) or hasGun(LocalPlayer) then break end
                firetouchinterest(root, touchPart, 0)
                task.wait()
                firetouchinterest(root, touchPart, 1)
                task.wait(0.02)
            end
        else
            local oldCFrame = root.CFrame
            root.CFrame = touchPart.CFrame
            task.wait(0.03)

            local GameplayRemotes = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Gameplay")
            if GameplayRemotes then
                if GameplayRemotes:FindFirstChild("FakeGun") then GameplayRemotes.FakeGun:FireServer() end
                if GameplayRemotes:FindFirstChild("GiveWeapon") then GameplayRemotes.GiveWeapon:FireServer() end
            end

            task.wait(0.03)
            if root and root.Parent then root.CFrame = oldCFrame end
        end
    end)
end

