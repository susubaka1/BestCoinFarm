-- =========================================================
--  ФУНКЦИИ ПРОВЕРКИ РОЛЕЙ И ИНВЕНТАРЯ
-- =========================================================
local function isPlayerAlive(targetPlr)
    local p = targetPlr or LocalPlayer
    local char = p and p.Character
    return char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid").Health > 0
end

local KNIFE_WORDS = {"knife", "blade", "scythe", "axe", "sword"}
local GUN_WORDS = {"gun", "revolver", "luger", "blaster", "bow"}

local function findToolObj(plr, words)
    if not plr then return nil end
    local function scanContainer(cont)
        if not cont then return nil end
        for _, item in ipairs(cont:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                for _, w in ipairs(words) do
                    if n:find(w) then return item end
                end
            end
        end
        return nil
    end
    return scanContainer(plr:FindFirstChild("Backpack")) or scanContainer(plr.Character)
end

local function hasKnife(plr)
    return findToolObj(plr, KNIFE_WORDS) ~= nil
end

local function hasGun(plr)
    return findToolObj(plr, GUN_WORDS) ~= nil
end

local function getPlayerRole(plr)
    local k = hasKnife(plr)
    local g = hasGun(plr)

    -- Если у кого-то в руках или инвентаре нож или пистолет - сразу точная роль:
    if k then return "Murderer" end
    if g then return "Sheriff" end

    -- Проверяем, выдано ли уже оружие на сервере (есть ли хоть один нож или ган)
    local weaponsDistributed = false
    for _, p in ipairs(Players:GetPlayers()) do
        if hasKnife(p) or hasGun(p) then
            weaponsDistributed = true
            break
        end
    end

    if weaponsDistributed then
        -- Оружие выдано: раз ножа и пистолета нет -> 100% невинный (мирный)!
        return "Innocent"
    end

    -- До выдачи оружия (старт раунда): смотрим ремоут текущего раунда
    -- Если мы в лобби или данных нет - все мирные (не берем старых маньяков с прошлого раунда)
    if isInLobby and isInLobby() then
        return "Innocent"
    end

    local rd = State.RoleData[plr.Name]
    local remoteRole = rd and rd.Role
    if remoteRole and remoteRole ~= "Innocent" then
        return remoteRole
    end

    return "Innocent"
end

local function isSurvivor(plr)
    local rd = State.RoleData[plr.Name]
    if rd and rd.Dead then return false end
    return getPlayerRole(plr) ~= "Murderer"
end

local function getPlayerRoleData(plr)
    local role = getPlayerRole(plr)
    if role == "Murderer" then return "Murderer", Theme.RoleMurderer end
    if role == "Sheriff" then return "Sheriff", Theme.RoleSheriff end
    return "Innocent", Theme.RoleInnocent
end

-- Находит ближайшего убийцу/зараженного с ножом (поддерживает обычный MM2 и режим Инфекция!)
local function getMurdererHRP()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position

    local closestMud = nil
    local closestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local rd = State.RoleData[p.Name]
                local isMud = hasKnife(p) or (rd and rd.Role == "Murderer" and not rd.Dead)
                if isMud then
                    if myPos then
                        local d = (root.Position - myPos).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closestMud = root
                        end
                    else
                        return root
                    end
                end
            end
        end
    end
    return closestMud
end

-- Проверка опасности от ЛЮБОГО игрока с ножом в радиусе (Инфекция / мульти-мардеры)
local function isAnyMurdererNear(myPos, range)
    if not myPos then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local rd = State.RoleData[p.Name]
                if hasKnife(p) or (rd and rd.Role == "Murderer" and not rd.Dead) then
                    if (root.Position - myPos).Magnitude < range then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function isGunEquipped()
    local char = LocalPlayer.Character
    if not char then return false end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local n = item.Name:lower()
            for _, w in ipairs(GUN_WORDS) do
                if n:find(w) then return true end
            end
        end
    end
    return false
end

