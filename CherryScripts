--  ФЛИНГ С ЗАПОМИНАНИЕМ ПОЗИЦИИ И АВТО-ПРЕДИКТОМ
-- =========================================================
State.flingSpiralRadius = 22 -- х10: 22 = радиус 2.2 стада (слайдер в Player Fling)
State.flingSpinSpeed = 137 -- шаг угла за кадр

local function flingPlayer(targetPlr, customDuration)
    if not targetPlr or targetPlr == LocalPlayer then return false end
    local targetChar = targetPlr.Character
    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP then return false end
    local targetTorso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso") or targetHRP

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return false end

    local savedCFrame = hrp.CFrame
    local camera = workspace.CurrentCamera
    local oldCameraSubject = camera and camera.CameraSubject

    if camera and (targetHum or targetHRP) then
        camera.CameraSubject = targetHum or targetHRP
    end

    if stopIYFly then stopIYFly() end

    local startTime = tick()
    local angle = 0
    local isFlung = false
    local maxTime = customDuration or 8.0

    local flingConn
    flingConn = RunService.Heartbeat:Connect(function()
        local currentChar = LocalPlayer.Character
        local currentHRP = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")

        if not targetHRP or not targetHRP.Parent then
            isFlung = true
            if flingConn then flingConn:Disconnect(); flingConn = nil end
            return
        end

        if targetHum and targetHum.Health <= 0 then
            isFlung = true
            if flingConn then flingConn:Disconnect(); flingConn = nil end
            return
        end

        local targetVel = targetHRP.AssemblyLinearVelocity
        if targetVel.Magnitude > 350 or targetHRP.Position.Y < -40 then
            isFlung = true
            if flingConn then flingConn:Disconnect(); flingConn = nil end
            return
        end

        if camera and (targetHum or targetHRP) then
            if camera.CameraSubject ~= (targetHum or targetHRP) then
                camera.CameraSubject = targetHum or targetHRP
            end
        end

        if currentHRP and currentHRP.Parent then
            if currentHum then
                currentHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                currentHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                currentHum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                currentHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                currentHum.PlatformStand = false
                currentHum.Sit = false
            end

            for _, part in ipairs(currentChar:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            -- мах с гарантированным проходом через центр: каждые 180° тело
            -- точно в торсе цели (фикс "пролетает мимо хитбокса"),
            -- между этим - широкий мах, направление которого медленно вращается
            angle = angle + (State.flingSpinSpeed or 137)
            local rad = math.rad(angle)
            local R = (State.flingSpiralRadius or 22) / 10
            local swing = math.sin(rad * 0.5) * R
            local dirA = rad * 0.2
            local tPos = targetTorso.Position
            currentHRP.CFrame = CFrame.new(
                tPos + Vector3.new(math.cos(dirA) * swing, math.sin(rad) * R * 0.4, math.sin(dirA) * swing)
            ) * CFrame.Angles(rad * 2, rad * 2.7, rad * 1.9)
            currentHRP.AssemblyLinearVelocity = Vector3.new(9e9, 9e9, 9e9)
            currentHRP.AssemblyAngularVelocity = Vector3.new(9e9, 9e9, 9e9)
        end

        if tick() - startTime > maxTime then
            if flingConn then flingConn:Disconnect(); flingConn = nil end
            return
        end
    end)

    while flingConn and not isFlung and (tick() - startTime < maxTime) do
        task.wait()
    end

    if flingConn then flingConn:Disconnect(); flingConn = nil end

    local currentChar = LocalPlayer.Character
    local currentHRP = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
    local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")

    if currentHRP and currentHum and currentHum.Health > 0 then
        for _ = 1, 3 do
            currentHRP.AssemblyLinearVelocity = Vector3.zero
            currentHRP.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end

        if savedCFrame then
            currentHRP.CFrame = savedCFrame
            currentHRP.AssemblyLinearVelocity = Vector3.zero
            currentHRP.AssemblyAngularVelocity = Vector3.zero
        end
    end

    task.delay(0.2, function()
        if camera then
            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if myHum then
                camera.CameraSubject = myHum
            elseif oldCameraSubject and oldCameraSubject.Parent then
                camera.CameraSubject = oldCameraSubject
            end
        end
    end)

    return isFlung
end

