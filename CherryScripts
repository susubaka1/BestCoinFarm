local function toggleFeatureByName(featName)
    local feat = getFeature(featName)
    if not feat then return end

    feat.Enabled = not feat.Enabled

    local name = feat.Name
    if name == "Shoot Through Walls" then
        getgenv().PistolAimConfig.Active = feat.Enabled
    elseif name == "Kill Aura" then
        getgenv().AimbotConfig.Active = feat.Enabled
    elseif name == "Auto Pickup Gun" and feat.Enabled then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "GunDrop" then instantPickup(obj) end
        end
    elseif name == "Aimbot" then
        getgenv().AimAssistConfig.Active = feat.Enabled
    elseif name == "Silent Aim" or name == "Aimbot V2" then
        getgenv().AimbotV2Config.Active = feat.Enabled
    elseif name == "Knife Aimbot" then
        getgenv().KnifeAimConfig.Active = feat.Enabled
    elseif name == "Gun ESP" then
        getgenv().GunESPEnabled = feat.Enabled
        if updateGunESP then updateGunESP() end
    elseif name == "Anti Fling" and not feat.Enabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, part in ipairs(plr.Character:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    elseif (name == "Speed" or name == "Speed Glitch") and not feat.Enabled then
        if isPlayerAlive() then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end
        end
    end

    if State.ScreenButtons and State.ScreenButtons[featName] then
        updateScreenBtnVisual(State.ScreenButtons[featName], feat)
    end

    if GUI.CurrentTab == feat.Category and renderFeatureCards then
        renderFeatureCards(UI.SearchBox.Text)
    end
end

