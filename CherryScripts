local function saveConfigToFile(name)
    local bindsData = {}
    for featName, key in pairs(FeatureBinds) do
        if key then bindsData[featName] = key.Name end
    end

    local data = { 
        Features = {}, 
        FeatureBinds = bindsData,
        BackgroundEffect = GUI.BackgroundEffect,
        GuiScale = GUI.Scale,
        GuiTransparency = GUI.Transparency,
        ElementTransparency = GUI.ElementTransparency,
        GlowPulse = GUI.GlowPulse,
        OpenKey = GUI.OpenKey.Name,
        BlurEnabled = GUI.BlurEnabled,
        FloatingBtnVisible = State.isFloatingBtnVisible,
        Theme = {
            Accent = {Theme.Accent.R, Theme.Accent.G, Theme.Accent.B},
            Background = {Theme.Background.R, Theme.Background.G, Theme.Background.B},
            Sidebar = {Theme.Sidebar.R, Theme.Sidebar.G, Theme.Sidebar.B},
            CardBg = {Theme.CardBg.R, Theme.CardBg.G, Theme.CardBg.B},
            CardBorder = {Theme.CardBorder.R, Theme.CardBorder.G, Theme.CardBorder.B},
            TabInactive = {Theme.TabInactive.R, Theme.TabInactive.G, Theme.TabInactive.B},
            GradientStart = {Theme.GradientStart.R, Theme.GradientStart.G, Theme.GradientStart.B},
            GradientEnd = {Theme.GradientEnd.R, Theme.GradientEnd.G, Theme.GradientEnd.B},
            TextMain = {Theme.TextMain.R, Theme.TextMain.G, Theme.TextMain.B}
        }
    }
    for _, feat in ipairs(GUI.Features) do
        local featData = { Name = feat.Name, Enabled = feat.Enabled, Settings = {} }
        if feat.Settings then
            for _, stg in ipairs(feat.Settings) do
                table.insert(featData.Settings, { Name = stg.Name, Value = stg.Value })
            end
        end
        table.insert(data.Features, featData)
    end
    writefile(CONFIG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(data))
end

local function loadConfigFromFile(name)
    local path = CONFIG_DIR .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local data = HttpService:JSONDecode(readfile(path))

    if data and data.Features then
        for _, savedFeat in ipairs(data.Features) do
            for _, feat in ipairs(GUI.Features) do
                if feat.Name == savedFeat.Name then
                    feat.Enabled = savedFeat.Enabled
                    if savedFeat.Settings and feat.Settings then
                        for _, savedStg in ipairs(savedFeat.Settings) do
                            for _, stg in ipairs(feat.Settings) do
                                if stg.Name == savedStg.Name then
                                    stg.Value = savedStg.Value
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if data and data.FeatureBinds then
        table.clear(FeatureBinds)
        for featName, keyName in pairs(data.FeatureBinds) do
            if Enum.KeyCode[keyName] then
                FeatureBinds[featName] = Enum.KeyCode[keyName]
            end
        end
    end

    if data and data.BackgroundEffect then
        applyBackgroundEffect(data.BackgroundEffect)
    end

    if data and data.OpenKey and Enum.KeyCode[data.OpenKey] then
        GUI.OpenKey = Enum.KeyCode[data.OpenKey]
        if UI.KeybindBtn then UI.KeybindBtn.Text = "Bind: [" .. GUI.OpenKey.Name .. "]" end
    end

    if data and data.GuiScale then
        GUI.Scale = data.GuiScale
        UI.ScaleValueLabel.Text = math.floor(GUI.Scale * 100) .. "%"
        local rel = math.clamp((GUI.Scale - 0.6) / (1.4 - 0.6), 0, 1)
        UI.ScaleSliderFill.Size = UDim2.new(rel, 0, 1, 0)
        if GUI.MenuOpen then UI.MainScale.Scale = GUI.Scale end
    end

    if data and data.GuiTransparency then
        GUI.Transparency = math.clamp(tonumber(data.GuiTransparency) or 0, 0, 0.85)
    end

    if data and data.ElementTransparency and typeof(data.ElementTransparency) == "table" then
        GUI.ElementTransparency = {}
        for tKey, tVal in pairs(data.ElementTransparency) do
            GUI.ElementTransparency[tostring(tKey)] = math.clamp(tonumber(tVal) or 0, 0, 0.85)
        end
    end
    applyTransparency()

    if data and data.BlurEnabled ~= nil then
        GUI.BlurEnabled = data.BlurEnabled and true or false
        if GUI.BlurEnabled and GUI.MenuOpen then
            MenuBlur.Enabled = true
            MenuBlur.Size = 20
        else
            MenuBlur.Enabled = false
            MenuBlur.Size = 0
        end
    end

    if data and data.FloatingBtnVisible ~= nil then
        State.isFloatingBtnVisible = data.FloatingBtnVisible and true or false
        UI.FloatingToggleBtn.Visible = State.isFloatingBtnVisible
    end

    if data and data.GlowPulse ~= nil then
        GUI.GlowPulse = math.clamp(tonumber(data.GlowPulse) or 1, 0, 1)
    end

    -- чекбоксы интерфейса должны показывать загруженное состояние
    local function syncUiCheck(fill, stroke, on)
        fill.Size = on and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 0, 0)
        stroke.Color = on and Theme.Accent or Color3.fromRGB(48, 48, 62)
    end
    syncUiCheck(UI.floatCheckFill, UI.floatCheckStroke, State.isFloatingBtnVisible)
    syncUiCheck(UI.blurCheckFill, UI.blurCheckStroke, GUI.BlurEnabled)

    if data and data.Theme then
        local t = data.Theme
        local loadedTheme = {
            Accent = Color3.new(t.Accent[1], t.Accent[2], t.Accent[3]),
            Background = Color3.new(t.Background[1], t.Background[2], t.Background[3]),
            Sidebar = Color3.new(t.Sidebar[1], t.Sidebar[2], t.Sidebar[3]),
            CardBg = Color3.new(t.CardBg[1], t.CardBg[2], t.CardBg[3]),
            CardBorder = Color3.new(t.CardBorder[1], t.CardBorder[2], t.CardBorder[3]),
            TabInactive = t.TabInactive and Color3.new(t.TabInactive[1], t.TabInactive[2], t.TabInactive[3]) or nil,
            GradientStart = t.GradientStart and Color3.new(t.GradientStart[1], t.GradientStart[2], t.GradientStart[3]) or nil,
            GradientEnd = t.GradientEnd and Color3.new(t.GradientEnd[1], t.GradientEnd[2], t.GradientEnd[3]) or nil,
            TextMain = t.TextMain and Color3.new(t.TextMain[1], t.TextMain[2], t.TextMain[3]) or Theme.TextMain
        }
        applyTheme(loadedTheme)
    end

    local stw = getFeature("Shoot Through Walls")
    if stw then getgenv().PistolAimConfig.Active = stw.Enabled end
    local ka = getFeature("Kill Aura")
    if ka then getgenv().AimbotConfig.Active = ka.Enabled end
    local aim = getFeature("Aimbot")
    if aim then
        getgenv().AimAssistConfig.Active = aim.Enabled
        getgenv().AimAssistConfig.OnlyWithGun = getSetting("Aimbot", "Only with gun") or false
        getgenv().AimAssistConfig.AutoShoot = getSetting("Aimbot", "Auto Shoot") or false
    end
    local aimv2 = getFeature("Silent Aim") or getFeature("Aimbot V2")
    if aimv2 then getgenv().AimbotV2Config.Active = aimv2.Enabled end
    local knifeAim = getFeature("Knife Aimbot")
    if knifeAim then
        getgenv().KnifeAimConfig.Active = knifeAim.Enabled
        getgenv().KnifeAimConfig.MaxDistance = getSetting("Knife Aimbot", "Макс. дистанция") or 200
        local partVal = getSetting("Knife Aimbot", "Target Part") or 1
        getgenv().KnifeAimConfig.TargetPart = partVal == 1 and "Head" or partVal == 2 and "Torso" or "Legs"
        getgenv().KnifeAimConfig.Prediction = getSetting("Knife Aimbot", "Prediction") or 0
        local wallCheckSetting = getSetting("Knife Aimbot", "Wall Check")
        getgenv().KnifeAimConfig.WallCheckEnabled = wallCheckSetting ~= false
    end
    local gunESP = getFeature("Gun ESP")
    if gunESP then getgenv().GunESPEnabled = gunESP.Enabled end

    if updateGunESP then updateGunESP() end
    if GUI.CurrentTab ~= "Configs" and GUI.CurrentTab ~= "Themes" and GUI.CurrentTab ~= "Binds" then
        renderFeatureCards(UI.SearchBox.Text)
    elseif GUI.CurrentTab == "Binds" then
        renderBindsList()
    end
    return true
end

local function deleteConfig(name)
    local path = CONFIG_DIR .. "/" .. name .. ".json"
    if isfile(path) then pcall(function() delfile(path) end) end
    if AUTOLOAD_NAME == name then
        AUTOLOAD_NAME = nil
        if isfile(AUTOLOAD_FILE) then pcall(function() delfile(AUTOLOAD_FILE) end) end
    end
    task.wait(0.05)
    if renderConfigsList then renderConfigsList() end
end

local function setAutoload(name, enable)
    if enable then
        AUTOLOAD_NAME = name
        writefile(AUTOLOAD_FILE, name)
    else
        if AUTOLOAD_NAME == name then
            AUTOLOAD_NAME = nil
            if isfile(AUTOLOAD_FILE) then delfile(AUTOLOAD_FILE) end
        end
    end
end

local function getConfigList()
    local files = listfiles(CONFIG_DIR)
    local configs = {}
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)%.json$")
        if name then table.insert(configs, name) end
    end
    return configs
end

local function attachConfirmationLogic(btn, defaultText, confirmText, successText, defaultBg, confirmBg, successBg, onConfirmAction)
    local state = "default"
    local resetTimer = nil

    btn.MouseButton1Click:Connect(function()
        if state == "default" then
            state = "sure"
            btn.Text = confirmText
            TweenService:Create(btn, TI.FAST, { BackgroundColor3 = confirmBg }):Play()

            if resetTimer then task.cancel(resetTimer) end
            resetTimer = task.delay(3, function()
                if state == "sure" then
                    state = "default"
                    btn.Text = defaultText
                    TweenService:Create(btn, TI.FAST, { BackgroundColor3 = defaultBg }):Play()
                end
            end)

        elseif state == "sure" then
            if resetTimer then task.cancel(resetTimer) end
            state = "success"
            btn.Text = successText
            TweenService:Create(btn, TI.FAST, { BackgroundColor3 = successBg }):Play()

            onConfirmAction()

            resetTimer = task.delay(1.5, function()
                state = "default"
                btn.Text = defaultText
                TweenService:Create(btn, TI.FAST, { BackgroundColor3 = defaultBg }):Play()
            end)
        end
    end)
end

