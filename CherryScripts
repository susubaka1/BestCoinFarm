local function getFeature(name)
    for _, f in ipairs(GUI.Features) do
        if f.Name == name then return f end
    end
    return nil
end

local function getSetting(featName, stgName)
    local f = getFeature(featName)
    if f and f.Settings then
        for _, s in ipairs(f.Settings) do
            if s.Name == stgName then return s.Value end
        end
    end
    return nil
end

