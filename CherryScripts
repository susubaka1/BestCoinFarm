        if UI.GlowShadow.Visible then UI.GlowShadow.ImageTransparency = pulse end
        UI.MainStrokeGradient.Rotation = (t * 45) % 360
        UI.LogoGradient.Rotation = (t * 30) % 360

        if GUI.BackgroundEffect == "Nebula Waves" then
            UI.MainBgGradient.Rotation = (t * 18) % 360
            local shift = math.sin(t * 1.2) * 0.12
            UI.MainBgGradient.Offset = Vector2.new(shift, -shift)
        elseif GUI.BackgroundEffect == "Starfield" then
            for _, s in ipairs(starsList) do
                local curY = s.Obj.Position.Y.Scale - s.SpeedY
                if curY < 0 then curY = 1 end
                s.Obj.Position = UDim2.new(s.Obj.Position.X.Scale, 0, curY, 0)
                s.Obj.BackgroundTransparency = math.clamp(s.BaseTrans + math.sin(t * 4 + s.SpeedY * 100) * 0.2, 0.1, 0.95)
            end
        elseif GUI.BackgroundEffect == "Cyber Grid" then
            for idx, line in ipairs(cyberGridLines) do
                line.BackgroundColor3 = Theme.Accent
            end
        end
    end
end)

