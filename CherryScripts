RunService.Heartbeat:Connect(function()
    if not runAlive() then return end
    if isPlayerAlive() then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if hum and hrp and not hrp:FindFirstChild("IY_Velocity") then
            local speedGlitch = getFeature("Speed Glitch")
            local speedFeat = getFeature("Speed")

            if speedGlitch and speedGlitch.Enabled then
                local airSpeed = getSetting("Speed Glitch", "Скорость в воздухе") or 45
                local groundSpeed = getSetting("Speed Glitch", "Скорость на земле") or 16

                local isAir = (hum.FloorMaterial == Enum.Material.Air) or hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping
                if isAir then
                    hum.WalkSpeed = airSpeed
                    local moveDir = hum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        local currentY = hrp.AssemblyLinearVelocity.Y
                        local targetHoriz = moveDir * airSpeed
                        hrp.AssemblyLinearVelocity = Vector3.new(targetHoriz.X, currentY, targetHoriz.Z)
                    end
                else
                    hum.WalkSpeed = groundSpeed
                end
            elseif speedFeat and speedFeat.Enabled then
                local speedVal = getSetting("Speed", "Скорость") or 16
                hum.WalkSpeed = speedVal
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    if not runAlive() then return end
    local antiFling = getFeature("Anti Fling")
    if antiFling and antiFling.Enabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, part in ipairs(plr.Character:GetChildren()) do
