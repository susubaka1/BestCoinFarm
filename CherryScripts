-- Перехват FireServer (__namecall)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" then
        local remoteName = tostring(self)
        if remoteName == "Shoot" then
            local pistolConfig = getgenv().PistolAimConfig
            local aimv2Config = getgenv().AimbotV2Config

            if pistolConfig.Active and not pistolConfig.IgnoreAutoShoot and pistolConfig.TargetPos then
                local arg1, arg2 = args[1], args[2]
                if typeof(arg1) == "CFrame" and typeof(arg2) == "CFrame" then
                    local vel = pistolConfig.TargetVelocity or Vector3.zero
                    local offsetY = math.clamp(vel.Y * pistolConfig.PredictPowerY, -pistolConfig.MaxVerticalOffset, pistolConfig.MaxVerticalOffset)
                    local predicted = pistolConfig.TargetPos + Vector3.new(vel.X * pistolConfig.PredictPowerX, offsetY, vel.Z * pistolConfig.PredictPowerZ)
                    local fakeSpawn = pistolConfig.TargetPos + Vector3.new(0, 1.5, 0)
                    return oldNamecall(self, CFrame.new(fakeSpawn) * arg1.Rotation, CFrame.new(predicted) * arg2.Rotation)
                end
            elseif aimv2Config.Active and not aimv2Config.IgnoreAutoShoot and aimv2Config.TargetPos then
                local arg1, arg2 = args[1], args[2]
                if typeof(arg1) == "CFrame" and typeof(arg2) == "CFrame" then
                    local vel = aimv2Config.TargetVelocity or Vector3.zero
                    local offsetY = math.clamp(vel.Y * aimv2Config.PredictPowerY, -aimv2Config.MaxVerticalOffset, aimv2Config.MaxVerticalOffset)
                    local predicted = aimv2Config.TargetPos + Vector3.new(vel.X * aimv2Config.PredictPowerX, offsetY, vel.Z * aimv2Config.PredictPowerZ)
                    return oldNamecall(self, arg1, CFrame.new(predicted) * arg2.Rotation)
                end
            end
        end

        local knifeConfig = getgenv().KnifeAimConfig
        if knifeConfig.Active and knifeConfig.TargetPos and remoteName ~= "Shoot" and remoteName ~= "HandleTouched" and remoteName ~= "KnifeStabbed" then
            local arg1, arg2 = args[1], args[2]
            if typeof(arg1) == "CFrame" and typeof(arg2) == "CFrame" then
                local targetPos = knifeConfig.TargetPos
                if knifeConfig.Prediction > 0 and knifeConfig.TargetVelocity then
                    targetPos = targetPos + knifeConfig.TargetVelocity * (knifeConfig.Prediction / 100)
                end
                return oldNamecall(self, arg1, CFrame.new(targetPos) * arg2.Rotation)
            end
        end

        if remoteName == "KnifeStabbed" or remoteName == "Slash" then
            KnifeRemotes.KnifeStabbed = self
            -- trigger only for the game's own calls; our aura must not re-trigger itself (crash fix)
            if not (checkcaller and checkcaller()) then
                task.spawn(triggerKnifeKillAura)
            end
        elseif remoteName == "HandleTouched" then
            KnifeRemotes.HandleTouched = self
        end
    end
    return oldNamecall(self, ...)
end)

