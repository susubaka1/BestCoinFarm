local function makeDraggable(handle, window)
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local dragStartPos = input.Position
            local startFramePos = window.Position
            local moveConn, releaseConn

            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch then
                    local delta = moveInput.Position - dragStartPos
                    window.Position = UDim2.new(
                        startFramePos.X.Scale,
                        startFramePos.X.Offset + delta.X,
                        startFramePos.Y.Scale,
                        startFramePos.Y.Offset + delta.Y
                    )
                end
            end)

            releaseConn = UserInputService.InputEnded:Connect(function(releaseInput)
                if releaseInput.UserInputType == Enum.UserInputType.MouseButton1 or releaseInput.UserInputType == Enum.UserInputType.Touch then
                    if moveConn then moveConn:Disconnect() end
                    if releaseConn then releaseConn:Disconnect() end
                end
            end)
        end
    end)
end

-- Universal slider drag helper (per-frame ratio callback + optional release callback)
local function attachSliderDrag(bgFrame, onRatio, onRelease)
    bgFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            onRatio(math.clamp((input.Position.X - bgFrame.AbsolutePosition.X) / math.max(bgFrame.AbsoluteSize.X, 1), 0, 1))
            local moveConn, releaseConn
            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch then
                    onRatio(math.clamp((moveInput.Position.X - bgFrame.AbsolutePosition.X) / math.max(bgFrame.AbsoluteSize.X, 1), 0, 1))
                end
            end)
            releaseConn = UserInputService.InputEnded:Connect(function(releaseInput)
                if releaseInput.UserInputType == Enum.UserInputType.MouseButton1 or releaseInput.UserInputType == Enum.UserInputType.Touch then
                    moveConn:Disconnect()
                    releaseConn:Disconnect()
