    if UI.updateCalibrationJumpCheck then
        UI.updateCalibrationJumpCheck(State.dummyJumpEnabled)
    end

    local holder = UI.AimCalibrationWin
    local scaleObj = holder and holder:FindFirstChildOfClass("UIScale")
    local mainWin = holder and holder:FindFirstChild("AimCalibrationWindow")
    if holder and scaleObj and mainWin then
