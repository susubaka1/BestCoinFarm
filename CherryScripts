        myHum:EquipTool(knife)
    end

    local target = config.TargetPart
    if not target or not target.Parent or not target:IsDescendantOf(workspace) then
        local shortest = getSetting("Kill Aura", "Unlimited Distance") and math.huge or (config.KillAuraRange or 200)
