local function setTargetColor(id, newCol)
    Theme[id] = newCol
    if id == "Accent" then
        Theme.ToggleOn = newCol
    elseif id == "UI.Sidebar" then
        Theme.TabInactive = newCol
    end
    applyTheme({})
end

