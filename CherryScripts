local function switchTab(tabName)
    if GUI.CurrentTab == tabName then return end
    GUI.CurrentTab = tabName

    for id, btn in pairs(UI.TabButtons) do
        local active = (id == tabName)
        local targetText = active and Theme.TextMain or Theme.TextDark
        TweenService:Create(btn, TI.FADE, {
            BackgroundColor3 = active and Theme.Accent or Theme.TabInactive
        }):Play()
        local icon = btn:FindFirstChild("TabIcon")
        if icon then
            TweenService:Create(icon, TI.FADE, { ImageColor3 = targetText }):Play()
        end
        local title = btn:FindFirstChild("TabTitle")
        if title then
            TweenService:Create(title, TI.FADE, { TextColor3 = targetText }):Play()
        end
    end

    UI.MainScrollGroup.Visible = false
    UI.ConfigsPage.Visible = false
    UI.ThemesPage.Visible = false
    UI.BindsPage.Visible = false

    UI.StatsPanel.Visible = (tabName ~= "Configs" and tabName ~= "Themes" and tabName ~= "Binds")

    local function smoothOpenPage(page, onOpen)
        page.Visible = true
        page.GroupTransparency = 1
        page.Position = UDim2.new(0, 0, 0, 8)
        if onOpen then onOpen() end
        TweenService:Create(page, TI.FAST, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) }):Play()
    end

    if tabName == "Configs" then
        smoothOpenPage(UI.ConfigsPage, function()
            if renderConfigsList then renderConfigsList() end
        end)
    elseif tabName == "Themes" then
        smoothOpenPage(UI.ThemesPage, function()
            if renderThemesList then renderThemesList() end
        end)
    elseif tabName == "Binds" then
        smoothOpenPage(UI.BindsPage, function()
            renderBindsList()
        end)
    else
        UI.MainScrollGroup.Visible = true
        UI.MainScrollGroup.GroupTransparency = 0
        UI.MainScrollGroup.Position = UDim2.new(0, 0, 0, 44)
        renderFeatureCards(UI.SearchBox.Text)
    end
end

