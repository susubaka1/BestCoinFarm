    end)

    -- Оптимизированный цикл с непрерывной фазой (никакой тряски при смене скорости и размера)
    RunService.RenderStepped:Connect(function(dt)
        if not winHolder.Visible then 
            State.dummyLastTick = os.clock()
            return 
        end

        local delta = math.clamp(dt or 0.016, 0.001, 0.05)
        local spd = (State.dummySpeed or 16) * 0.22
        local range = State.dummyStrafeRange or 8

        -- Непрерывный интегратор фазы: скорость меняется гладко, тело не скачет
        State.dummyStrafePhase = ((State.dummyStrafePhase or 0) + delta * spd) % (math.pi * 2)
        local phase = State.dummyStrafePhase

        local posX = math.sin(phase) * range
        local velX = math.cos(phase) * spd * range

        local jumpY = 0
        local velY = 0
        if State.dummyJumpEnabled == true then
            -- Физичный Roblox прыжок: цикл 0.85 сек (взлёт вверх -> гравитационный спад -> пауза на земле)
            local jumpCycle = 0.85
            State.dummyJumpPhase = ((State.dummyJumpPhase or 0) + delta) % jumpCycle
            local p = State.dummyJumpPhase / jumpCycle
            local h = State.dummyJumpHeight or 2.5
            if p < 0.7 then
                -- Время в воздухе (0..0.7): параболическая баллистика 4 * u * (1 - u)
                local u = p / 0.7
                jumpY = 4 * u * (1 - u) * h
                velY = (1 - 2 * u) * h * 5
            else
                -- Стоит на земле между прыжками
                jumpY = 0
                velY = 0
            end
        else
            State.dummyJumpPhase = 0
        end

        local rootPos = Vector3.new(posX, jumpY, 0)
        local rootCFrame = CFrame.new(rootPos)

        parts.HRP.CFrame = rootCFrame
        parts.Torso.CFrame = rootCFrame
        parts.Head.CFrame = rootCFrame * CFrame.new(0, 1.5, 0)
        parts.Hair.CFrame = rootCFrame * CFrame.new(0, 2.05, 0)

        local limbPhase = phase * 1.5
        local armSwing = math.cos(limbPhase) * 0.6
        parts.LA.CFrame = rootCFrame * CFrame.new(-1.5, 0, 0) * CFrame.Angles(armSwing, 0, 0)
        parts.RA.CFrame = rootCFrame * CFrame.new(1.5, 0, 0) * CFrame.Angles(-armSwing, 0, 0)

        local legSwing = math.sin(limbPhase) * 0.7
        parts.LL.CFrame = rootCFrame * CFrame.new(-0.5, -2, 0) * CFrame.Angles(legSwing, 0, 0)
        parts.RL.CFrame = rootCFrame * CFrame.new(0.5, -2, 0) * CFrame.Angles(-legSwing, 0, 0)

        -- 3D Прицел-крестик перед телом бекона (Z = +1.4)
        local predVal = getCurPred()
        local predLeadX = velX * (predVal / 100)
        local predLeadY = velY * (predVal / 100)
        local targetX = posX + predLeadX
        local targetY = jumpY + predLeadY
        local targetZ = 1.4 -- перед беконом (бекон на Z = 0, камера на Z = 11)

        local predictedTarget = Vector3.new(targetX, targetY, targetZ)

        reticleCenter.CFrame = CFrame.new(predictedTarget)
        reticleH.CFrame = CFrame.new(predictedTarget)
        reticleV.CFrame = CFrame.new(predictedTarget)
        reticleH_Outline.CFrame = CFrame.new(predictedTarget - Vector3.new(0, 0, 0.02))
        reticleV_Outline.CFrame = CFrame.new(predictedTarget - Vector3.new(0, 0, 0.02))
    end)

    UI.AimCalibrationWin = winHolder
    UI.AimCalibrationTitle = title
end

openAimCalibrationMenu = function(featName)
    buildAimCalibrationWindow()
    State.calibrationActiveFeature = featName or "Aimbot"
    if UI.AimCalibrationTitle then
        UI.AimCalibrationTitle.Text = "Advanced Settings · " .. State.calibrationActiveFeature
    end
    if UI.updateCalibrationPredSlider then
