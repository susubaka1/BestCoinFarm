local function createSwitch(parent, initialState, callback)
    local switchFrame = Instance.new("Frame")
    switchFrame.Size = UDim2.new(0, 38, 0, 20)
    switchFrame.Position = UDim2.new(1, -46, 0, 14)
    switchFrame.BackgroundColor3 = initialState and Theme.Accent or Theme.SwitchOff
    switchFrame.BackgroundTransparency = 1
    switchFrame.BorderSizePixel = 0
    switchFrame.Parent = parent
    Instance.new("UICorner", switchFrame).CornerRadius = UDim.new(0, 10)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = initialState and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    dot.BackgroundColor3 = Theme.SwitchDot
    dot.BackgroundTransparency = 1
    dot.BorderSizePixel = 0
    dot.Parent = switchFrame
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)

    local active = initialState

    local function setState(newState)
        active = newState
        TweenService:Create(switchFrame, TI.FAST, { BackgroundColor3 = active and Theme.Accent or Theme.SwitchOff }):Play()
        TweenService:Create(dot, TI.FAST, { Position = active and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }):Play()
        if callback then callback(active) end
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = switchFrame
    btn.MouseButton1Click:Connect(function() setState(not active) end)

    return setState, switchFrame, dot
end

local function updateDotsStyle(dotsBtn, feat, animate)
    if not dotsBtn then return end
    local bgCol, bgTrans, textCol
    if feat.Expanded then
        bgCol = Color3.fromRGB(255, 255, 255)
        bgTrans = 0.65
        textCol = Color3.fromRGB(255, 255, 255)
    elseif feat.Enabled then
        bgCol = Color3.fromRGB(255, 255, 255)
        bgTrans = 0.85
        textCol = Color3.fromRGB(255, 255, 255)
    else
        bgCol = Color3.fromRGB(28, 28, 38)
        bgTrans = 0
        textCol = Theme.TextDark
    end

    if animate then
        TweenService:Create(dotsBtn, TI.FAST, { BackgroundColor3 = bgCol, BackgroundTransparency = bgTrans, TextColor3 = textCol }):Play()
    else
        dotsBtn.BackgroundColor3 = bgCol
        dotsBtn.TextColor3 = textCol
    end
