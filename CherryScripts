local function getActiveKnifeAndRemotes()
    local knife = findToolObj(LocalPlayer, KNIFE_WORDS) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool"))
    if not knife then return nil, nil, nil end

    local handleTouched = KnifeRemotes.HandleTouched
    local knifeStabbed = KnifeRemotes.KnifeStabbed

    if not (handleTouched and knifeStabbed) then
        local evFolder = knife:FindFirstChild("Events")
        if evFolder then
            handleTouched = handleTouched or evFolder:FindFirstChild("HandleTouched")
            knifeStabbed = knifeStabbed or evFolder:FindFirstChild("KnifeStabbed")
        end
        handleTouched = handleTouched or knife:FindFirstChild("HandleTouched")
        knifeStabbed = knifeStabbed or knife:FindFirstChild("KnifeStabbed")
    end

    if handleTouched and not KnifeRemotes.HandleTouched then KnifeRemotes.HandleTouched = handleTouched end
    if knifeStabbed and not KnifeRemotes.KnifeStabbed then KnifeRemotes.KnifeStabbed = knifeStabbed end

    return knife, handleTouched, knifeStabbed
end

