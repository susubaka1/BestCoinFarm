        hum:ChangeState(Enum.HumanoidStateType.Freefall)
    end
    State.flyBV = Instance.new("BodyVelocity")
    State.flyBG = Instance.new("BodyGyro")
    State.flyBV.Name, State.flyBV.MaxForce, State.flyBV.Velocity, State.flyBV.Parent = "IY_Velocity", Vector3.new(1e9, 1e9, 1e9), Vector3.zero, hrp
    State.flyBG.Name, State.flyBG.MaxTorque, State.flyBG.Parent = "IY_Gyro", Vector3.new(1e9, 0, 1e9), hrp
    State.flyBG.CFrame = CFrame.new(Vector3.zero, hrp.CFrame.LookVector * Vector3.new(1, 0, 1))
end

State.currentTargetCoin = nil
State.flyConnection = nil

local function stopFlying()
    if State.flyConnection then State.flyConnection:Disconnect(); State.flyConnection = nil end
    stopIYFly()
    State.currentTargetCoin = nil
end

State.undercoinBusy = false

local function startFlyingToCoin(coin)
    if not coin or not coin:IsDescendantOf(workspace) or coin.Transparency >= 1 or State.collectedCoins[coin] then return false end
    if not isPlayerAlive() or isInLobby() then return false end

    local farmType = getSetting("Coin Farm", "Вид фарма") or "Fly"
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local mapName = getMapName()
    local isYacht = (mapName == "Yacht")

    -- -----------------------------------------------------
    -- РЕЖИМ 1: UNDERCOIN (ТП/ТВИН ПОД НИЗ МОНЕТЫ -> 0.5с -> СБОР НА СКОРОСТИ 20)
    -- -----------------------------------------------------
    if farmType == "Undercoin" then
        if State.undercoinBusy then return true end
        State.undercoinBusy = true
        task.spawn(function()
            stopFlying()
            startIYFly()
            local coinPos = coin.Position
            local underPos = coinPos - Vector3.new(0, 5.5, 0) -- 5.5 стадов строго под монетой
            local approachMethod = getSetting("Coin Farm", "Метод Undercoin") or "Tween"
            local approachSpeed = getSetting("Coin Farm", "Скорость подлета (Undercoin)") or 80

            local bv = hrp:FindFirstChild("IY_Velocity")

            -- Функция проверки, жива ли еще монета (не подобрал ли её кто-��о другой)
            local function isCoinValid()
                return coin and coin.Parent and coin:IsDescendantOf(workspace) and coin.Transparency < 0.9 and not State.collectedCoins[coin]
            end

            -- 1. Двухэтапный подход к точке под монетой
            if approachMethod == "TP" then
                hrp.CFrame = CFrame.new(underPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
            else
                -- ДВУХЭТАПНЫЙ ТВИН:
                -- Этап 1А: Сначала опускаемся по Y строго вниз на уровень underPos.Y
                local curY = hrp.Position.Y
                local targetY = underPos.Y
                if curY > targetY + 1.0 then
                    local yDist = curY - targetY
                    local yTime = yDist / math.max(approachSpeed, 30)
                    local yStart = os.clock()
                    while os.clock() - yStart < yTime and isPlayerAlive() and isCoinValid() do
                        local diffY = targetY - hrp.Position.Y
                        if math.abs(diffY) < 1.2 then break end
                        if bv then bv.Velocity = Vector3.new(0, math.sign(diffY) * approachSpeed, 0) end
                        RunService.Heartbeat:Wait()
                    end
                end

                -- Этап 1Б: Движение к точке под монетой (горизонталь XZ + облет других монет)
                local dist = (underPos - hrp.Position).Magnitude
                local flyTime = math.clamp(dist / math.max(approachSpeed, 30) * 1.5, 0.4, 8.0)
                local startT = os.clock()
                while os.clock() - startT < flyTime and isPlayerAlive() and isCoinValid() do
                    local curPos = hrp.Position
                    local toUnder = underPos - curPos
                    if toUnder.Magnitude < 1.8 then break end

                    local dir = toUnder.Unit

                    -- ЧЕК НА ДРУГИЕ МОНЕТЫ: если путь проходит через другую монету, облетаем по XZ
                    local avoidVector = Vector3.zero
                    for _, otherCoin in ipairs(State.activeCoins) do
                        if otherCoin ~= coin and otherCoin.Parent and otherCoin:IsDescendantOf(workspace) and otherCoin.Transparency < 0.9 and not State.collectedCoins[otherCoin] then
                            local cPos = otherCoin.Position
                            local toOther = cPos - curPos
                            -- Проверяем, впереди ли монета по ходу движения
                            local dotForward = toOther:Dot(dir)
                            if dotForward > 0 and dotForward < 35 then
                                -- Проекция позиции монеты на наш вектор движения
                                local projPoint = curPos + dir * dotForward
                                local perpDist = (cPos - projPoint).Magnitude
                                -- Если монета лежит слишком близко к коридору полета (менее 6.5 стадов)
                                if perpDist < 6.5 then
                                    local pushAway = (projPoint - cPos)
                                    if pushAway.Magnitude < 0.2 then
                                        -- Перпендикуляр в плоскости XZ
                                        pushAway = Vector3.new(-dir.Z, 0, dir.X)
                                    else
                                        pushAway = Vector3.new(pushAway.X, 0, pushAway.Z).Unit
                                    end
                                    local strength = (6.5 - perpDist) / 6.5
                                    avoidVector = avoidVector + pushAway * (strength * 1.4)
                                end
                            end
                        end
                    end

                    local finalDir = (dir + avoidVector).Unit
                    if bv then bv.Velocity = finalDir * approachSpeed end
                    RunService.Heartbeat:Wait()
                end
            end

            -- Если монету уже забрали пока летели — сразу прекращаем и идем к следующей
            if not isCoinValid() then
                State.collectedCoins[coin] = true
                stopFlying()
                State.undercoinBusy = false
                return
            end

            -- 2. Зависание под монетой с постоянным чеком: если кто-то подобрал, сразу прерываемся!
            if bv then bv.Velocity = Vector3.zero end
            local waitUnderTime = getSetting("Coin Farm", "Ожидание под монетой") or 0.5
            local waitStart = os.clock()
            while os.clock() - waitStart < waitUnderTime and isPlayerAlive() do
                if not isCoinValid() then
                    -- Монету подобрал другой игрок! Моментально летим к другой монете!
                    State.collectedCoins[coin] = true
                    stopFlying()
                    State.undercoinBusy = false
                    return
                end
                RunService.Heartbeat:Wait()
            end

            -- 3. Плавный подъем вверх для сбора монеты:
            -- Скорость подбора монеты берется строго из слайдера «Скорость полета» (20-25) независимо от скорости подлета!
            local collectSpeed = getSetting("Coin Farm", "Скорость полета") or 22
            local collectStart = os.clock()
            while os.clock() - collectStart < 1.4 and isPlayerAlive() and isCoinValid() do
                local toCoin = (coin.Position - hrp.Position)
                if toCoin.Magnitude <= 2.8 and firetouchinterest then
                    firetouchinterest(hrp, coin, 0)
                    task.wait()
                    firetouchinterest(hrp, coin, 1)
                    State.collectedCoins[coin] = true
                    break
                end
                if bv then bv.Velocity = toCoin.Unit * collectSpeed end
                RunService.Heartbeat:Wait()
            end

            State.collectedCoins[coin] = true
            stopFlying()

            -- 4. Кастомная задержка после сбора монеты (от 0.0 до 2.0 сек)
            local afterCollectDelay = getSetting("Coin Farm", "Задержка после сбора") or 0.0
            if afterCollectDelay > 0.02 then task.wait(afterCollectDelay) end

            State.undercoinBusy = false
        end)
        return true
    end

    -- -----------------------------------------------------
    -- РЕЖИМ 2: СТАНДАРТНЫЙ ПОЛЕТ (FLY)
    -- -----------------------------------------------------
    stopFlying()
    startIYFly()
    State.currentTargetCoin = coin

    local function onStep()
        if not runAlive() then stopFlying() return end
        local farmFeat = getFeature("Coin Farm")
        if not farmFeat or not farmFeat.Enabled or State.autoDisableFarmCurrentRound or not isPlayerAlive() or isInLobby() then stopFlying(); return end
        if not State.currentTargetCoin or not State.currentTargetCoin:IsDescendantOf(workspace) or State.currentTargetCoin.Transparency >= 1 or State.collectedCoins[State.currentTargetCoin] then stopFlying(); return end
        
        local hrpCurrent = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrpCurrent then stopFlying(); return end

        local myPos = hrpCurrent.Position

        local isDodgeEnabled = getSetting("Coin Farm", "Auto Dodge Knife")
        if isDodgeEnabled then
            local dodgeDir, knifeDist = checkKnifeThreat(myPos)
            if dodgeDir then
                local dodgeTarget = myPos + dodgeDir * 20
                if isYacht then dodgeTarget = Vector3.new(dodgeTarget.X, math.max(dodgeTarget.Y, YACHT_MIN_HEIGHT), dodgeTarget.Z) end
                local bv = hrpCurrent:FindFirstChild("IY_Velocity")
                if bv then bv.Velocity = dodgeDir * (State.flySpeed * 2.2) end
                return
            end
        end

        local bestCoin = State.currentTargetCoin
        local bestDist = (State.currentTargetCoin.Position - myPos).Magnitude
        local isDodgeMurder = getSetting("Coin Farm", "Dodge Murderer")

        for _, c in ipairs(State.activeCoins) do
            if c and c:IsDescendantOf(workspace) and c.Transparency < 1 and not State.collectedCoins[c] then
                if not (isYacht and c.Position.Y < YACHT_MIN_HEIGHT) then
                    -- Если Dodge Murderer ВЫКЛЮЧЕН (false), НЕ делаем монету опасной! Летим к ЛЮБОЙ ближайшей монете!
                    local isCoinDangerous = (isDodgeMurder == true) and isAnyMurdererNear(c.Position, State.safeDistance)
                    if not isCoinDangerous then
                        local d = (c.Position - myPos).Magnitude
                        if d + 3 < bestDist then
                            bestDist = d
                            bestCoin = c
                        end
                    end
                end
            end
        end
        State.currentTargetCoin = bestCoin

        local targetPos = State.currentTargetCoin.Position
        local distToTarget = (targetPos - myPos).Magnitude

        if distToTarget <= 3.5 and firetouchinterest then
            firetouchinterest(hrpCurrent, State.currentTargetCoin, 0)
            task.wait()
            firetouchinterest(hrpCurrent, State.currentTargetCoin, 1)
        end

        -- Автострельба сквозь стены на карте Barn во время сбора монет
        local isBarnMap = (mapName:lower():find("barn") ~= nil) or (workspace:FindFirstChild("Barn") ~= nil)
        local shootBarnActive = getSetting("Coin Farm", "Shoot on Barn while Farming")
        local mud = getMurdererHRP()
        if isBarnMap and shootBarnActive and hasGun(LocalPlayer) and mud then
            local now = os.clock()
            if now - (State.lastBarnShoot or 0) >= 0.5 then
                State.lastBarnShoot = now
                task.spawn(shootAtMurderer)
            end
        end

        -- Строго проверяем Dodge Murderer: если выключен (false), перс НИКОГДА не улетает под пол!
        local isThreat = (isDodgeMurder == true) and (isAnyMurdererNear(myPos, State.safeDistance) or (mud and (myPos - mud.Position).Magnitude < State.safeDistance))
        if isThreat then
            local escapeY = myPos.Y - 15
            if isYacht then escapeY = math.min(escapeY, YACHT_MIN_HEIGHT - 10) end
            targetPos = Vector3.new(myPos.X, escapeY, myPos.Z)
        else
            if isYacht then targetPos = Vector3.new(targetPos.X, math.max(targetPos.Y, YACHT_MIN_HEIGHT), targetPos.Z) end
            if distToTarget < 1.0 or State.currentTargetCoin.Transparency >= 0.9 then
                State.collectedCoins[State.currentTargetCoin] = true
                stopFlying()
                local afterDelay = getSetting("Coin Farm", "Задержка после сбора") or 0.2
                if afterDelay > 0 then task.wait(afterDelay) end
                return
            end
        end

        local dir = targetPos - myPos
        local bv = hrpCurrent:FindFirstChild("IY_Velocity")
        if bv then 
            local setFlySpeed = getSetting("Coin Farm", "Скорость полета") or State.flySpeed or 22
            local currentSpeed = (isDodgeMurder == true and mud and (myPos - mud.Position).Magnitude < State.safeDistance) and (setFlySpeed * 1.3) or setFlySpeed
            bv.Velocity = dir.Unit * currentSpeed 
        else 
            stopFlying() 
        end
    end

    State.flyConnection = RunService.Stepped:Connect(onStep)
    return true
end

