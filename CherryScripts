local function getTargetLobbyCFrame()
    local targetPart = nil

    -- Точный путь: workspace.Lobby.Spawns (выбираем любой спавн из детей)
    pcall(function()
        local lobby = workspace:FindFirstChild("Lobby")
        local spawnsFolder = lobby and lobby:FindFirstChild("Spawns")
        if spawnsFolder then
            local validSpawns = {}
            for _, s in ipairs(spawnsFolder:GetChildren()) do
                local p = (s:IsA("BasePart") and s) or s:FindFirstChildWhichIsA("BasePart", true)
                if p and p:IsA("BasePart") then
                    table.insert(validSpawns, p)
                end
            end
            if #validSpawns > 0 then
                targetPart = validSpawns[math.random(1, #validSpawns)]
            end
        end
    end)

    if targetPart and targetPart:IsA("BasePart") then
        return targetPart.CFrame + Vector3.new(0, 3.5, 0)
    end

    -- Запасной поиск: спавн в workspace.Lobby.Lobby или любой BasePart в Spawns
    pcall(function()
        local lobby = workspace:FindFirstChild("Lobby")
        if lobby then
            local sp = lobby:FindFirstChild("Spawns", true)
            if sp then
                local ch = sp:GetChildren()
                if #ch > 0 then
                    local chosen = ch[math.random(1, #ch)]
                    targetPart = (chosen:IsA("BasePart") and chosen) or chosen:FindFirstChildWhichIsA("BasePart", true)
                end
            end
        end
    end)

    if targetPart and targetPart:IsA("BasePart") then
        return targetPart.CFrame + Vector3.new(0, 3.5, 0)
    end

    return nil
end

