task.spawn(function()
    while runAlive() do
        task.wait(0.2)
        pcall(function()
            local farmFeat = getFeature("Coin Farm")
            local isFarming = farmFeat and farmFeat.Enabled

            local mapName = getMapName()
            local isYacht = (mapName == "Yacht")

            if isFarming and not State.autoDisableFarmCurrentRound and isPlayerAlive() and not isInLobby() then
                State.wasStoppedInLobby = false

                if isBagFull() then
                    stopFlying()
                    State.autoDisableFarmCurrentRound = true
                    local farmMode = getSetting("Coin Farm", "Режим фарма") or "Farm Coins"

                    if farmMode == "Farm Coins" then
                        local flingMud = getSetting("Coin Farm", "Fling Murderer")
                        local autoReset = getSetting("Coin Farm", "Auto Reset")

                        if flingMud == true then
                            local char = LocalPlayer.Character
                            local hum = char and char:FindFirstChildOfClass("Humanoid")
                            if hum then hum.Health = 0 end
                            task.wait(0.05)
                            flingMurderer()
                        elseif autoReset == true then
                            local char = LocalPlayer.Character
                            local hum = char and char:FindFirstChildOfClass("Humanoid")
                            if hum then hum.Health = 0 end
                        end
                        return

                    elseif farmMode == "Farm Coins + XP" then
                        local lobbyTp = getSetting("Coin Farm", "Lobby Teleport")
                        local autokillMud = getSetting("Coin Farm", "Autokill if Murderer")
                        local autokillSheriff = getSetting("Coin Farm", "Autokill if Sheriff/Hero")

                        if lobbyTp and not hasKnife(LocalPlayer) then
                            teleportToLobby()
                            task.wait(0.2)
                        end

                        if hasKnife(LocalPlayer) and autokillMud then
                            task.spawn(function()
                                while isPlayerAlive() and #State.activeCoins > 0 do
                                    attackAllSurvivors()
                                    task.wait(0.15)
                                end
                            end)
                        elseif autokillSheriff then
                            task.spawn(function()
                                local isBarn = (mapName:lower():find("barn") ~= nil) or (workspace:FindFirstChild("Barn") ~= nil)
                                local resetBarn = getSetting("Coin Farm", "Reset if Sheriff on Barn")
                                while isPlayerAlive() and not hasGun(LocalPlayer) do task.wait(0.2) end
                                if isPlayerAlive() and hasGun(LocalPlayer) then
                                    if isBarn and resetBarn then
                                        local char = LocalPlayer.Character
                                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                                        if hum then hum.Health = 0 end
                                        return
                                    end
                                    -- Если это карта Barn и включен сбор монет: не стреляем сразу при спавне,
                                    -- а ждем пока начнется фарм монет (стрельба идет во время полета за монетами)
                                    local shootBarnFarming = getSetting("Coin Farm", "Shoot on Barn while Farming")
                                    if isBarn and shootBarnFarming then
                                        return
                                    end
                                    -- На других картах стреляем после того как раунд полноценно начался (появились монеты)
                                    while isPlayerAlive() and #State.activeCoins == 0 do task.wait(0.3) end
                                    while isPlayerAlive() and hasGun(LocalPlayer) and getMurdererHRP() do
                                        shootAtMurderer()
                                        task.wait(0.3)
                                    end
                                end
                            end)
                        end
                        return
                    end
                end

                if State.currentTargetCoin then
                    if not State.currentTargetCoin:IsDescendantOf(workspace) or State.currentTargetCoin.Transparency >= 1 or State.collectedCoins[State.currentTargetCoin] then
                        stopFlying()
                    else
                        return
                    end
                end

                local closest, short = nil, math.huge
                local mud = getMurdererHRP()
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local isDodgeMurder = getSetting("Coin Farm", "Dodge Murderer")
                local collectMethod = getSetting("Coin Farm", "Метод сбора") or "Nearest"

                if hrp then
                    local availableCoins = {}
                    for _, coin in ipairs(State.activeCoins) do
                        if coin:IsDescendantOf(workspace) and coin.Transparency < 1 and not State.collectedCoins[coin] then
                            if isYacht and coin.Position.Y < YACHT_MIN_HEIGHT then continue end
                            local isCoinDangerous = (isDodgeMurder == true) and (isAnyMurdererNear(coin.Position, State.safeDistance) or (mud and (coin.Position - mud.Position).Magnitude < State.safeDistance))
                            if not isCoinDangerous then
                                table.insert(availableCoins, coin)
                                local d = (coin.Position - hrp.Position).Magnitude
                                if d < short then short, closest = d, coin end
                            end
                        end
                    end

                    if collectMethod == "Random" and #availableCoins > 0 then
                        closest = availableCoins[math.random(1, #availableCoins)]
                    end

                    if closest then
                        startFlyingToCoin(closest)
                    else
                        -- 7. Монеты еще не появились или кемперит маньяк:
                        -- Если мы невинный/выживший и маньяк в опасной близости -> прячемся под карту в ожидании монет!
                        local isDodgeMud = getSetting("Coin Farm", "Dodge Murderer")
                        if isDodgeMud ~= false and isAnyMurdererNear(hrp.Position, State.safeDistance + 10) then
                            startIYFly()
                            local bv = hrp:FindFirstChild("IY_Velocity")
                            if bv then
                                bv.Velocity = Vector3.new(0, -20, 0)
                            end
                        else
                            stopFlying()
                        end
                    end
                end
            elseif (isFarming or State.autoDisableFarmCurrentRound) and not State.wasStoppedInLobby then
                stopFlying()
                State.wasStoppedInLobby = true
                State.RoleData = {}
    State.CachedPerks = {} -- очищаем роли прошлого раунда при переходе в лобби
            end
        end)
    end
end)

