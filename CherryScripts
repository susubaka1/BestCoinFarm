local function shootAtMurderer()
    local mud = getMurdererHRP()
    if not mud or not isPlayerAlive() then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local gun = findToolObj(LocalPlayer, GUN_WORDS)
    if not gun then return end
    if gun.Parent == LocalPlayer.Backpack then
        hum:EquipTool(gun)
        task.wait(0.05)
    end

    local shootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChildWhichIsA("RemoteEvent")
    if shootRemote then
        local myHRP = char and char:FindFirstChild("HumanoidRootPart")
        -- Защита от умерших/стоящих в упор в дуле игроков в лобби:
        if myHRP then
            local myPos = myHRP.Position
            local hasBlocker = false
            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= LocalPlayer and other.Character then
                    local oRoot = other.Character:FindFirstChild("HumanoidRootPart")
                    if oRoot then
                        local dist = (oRoot.Position - myPos).Magnitude
                        if dist < 4.5 then
                            hasBlocker = true
                            break
                        end
                    end
                end
            end
            if hasBlocker then
                -- Смещаемся на свободную точку выше или в сторону от помехи
                myHRP.CFrame = myHRP.CFrame + Vector3.new(0, 6, 0)
                task.wait(0.04)
            end
        end

        local targetPos = mud.Position
        local vel = mud.AssemblyLinearVelocity or Vector3.zero
        local cfg = getgenv().PistolAimConfig
        local predX = targetPos.X + vel.X * (cfg.PredictPowerX or 0.18)
        local predY = math.clamp(targetPos.Y + vel.Y * (cfg.PredictPowerY or 0.08), targetPos.Y - (cfg.MaxVerticalOffset or 2.5), targetPos.Y + (cfg.MaxVerticalOffset or 2.5))
        local predZ = targetPos.Z + vel.Z * (cfg.PredictPowerZ or 0.18)
        local predictedTarget = Vector3.new(predX, predY, predZ)
        local fakeOrigin = targetPos + Vector3.new(0, 1.5, 0)

        cfg.IgnoreAutoShoot = true
        shootRemote:FireServer(CFrame.new(fakeOrigin), CFrame.new(predictedTarget))
        cfg.IgnoreAutoShoot = false
    end
end

