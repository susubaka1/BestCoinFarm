local function applyTheme(preset)
    preset = preset or {}
    Theme.Accent = preset.Accent or Theme.Accent
    Theme.ToggleOn = preset.Accent or Theme.ToggleOn or Theme.Accent
    Theme.Background = preset.Background or Theme.Background
    Theme.Sidebar = preset.Sidebar or Theme.Sidebar
    Theme.CardBg = preset.CardBg or Theme.CardBg
    Theme.CardBorder = preset.CardBorder or Theme.CardBorder
    Theme.TabInactive = preset.TabInactive or preset.Sidebar or Theme.TabInactive
    Theme.GradientStart = preset.GradientStart or preset.Accent or Theme.GradientStart
    Theme.GradientEnd = preset.GradientEnd or preset.Accent or Theme.GradientEnd
    Theme.TextMain = preset.TextMain or Theme.TextMain

    UI.GlowShadow.ImageColor3 = Theme.Accent
    UI.MainStroke.Color = Theme.Accent

    UI.FloatingToggleBtn.BackgroundColor3 = Theme.CardBg
    UI.FloatingToggleBtn.TextColor3 = Theme.Accent
    UI.FloatingStroke.Color = Theme.Accent

    UI.CrossRingStroke.Color = Theme.Accent
    UI.CrossDot.BackgroundColor3 = Theme.TextMain
    for _, crossBar in ipairs(UI.CrossBars) do
        crossBar.BackgroundColor3 = Theme.Accent
    end

    UI.MainStrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.GradientStart),
        ColorSequenceKeypoint.new(0.5, Theme.Accent),
        ColorSequenceKeypoint.new(1, Theme.GradientEnd)
    })

    TweenService:Create(UI.MainFrame, TI.FAST, { BackgroundColor3 = Theme.Background }):Play()
    TweenService:Create(UI.Sidebar, TI.FAST, { BackgroundColor3 = Theme.Sidebar }):Play()
    TweenService:Create(UI.StatsPanel, TI.FAST, { BackgroundColor3 = Theme.CardBg, BorderColor3 = Theme.CardBorder }):Play()
    TweenService:Create(UI.GuiSettingsPanel, TI.FAST, { BackgroundColor3 = Theme.CardBg, BorderColor3 = Theme.CardBorder }):Play()
    TweenService:Create(UI.SearchBox, TI.FAST, { BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextMain }):Play()
    TweenService:Create(UI.CloseBtn, TI.FAST, { BackgroundColor3 = Theme.Sidebar }):Play()
    TweenService:Create(UI.NewConfigInput, TI.FAST, { BackgroundColor3 = Theme.CardBg, TextColor3 = Theme.TextMain }):Play()
    TweenService:Create(UI.CreateConfigBtn, TI.FAST, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextMain }):Play()
    TweenService:Create(UI.KeybindBtn, TI.FAST, { BackgroundColor3 = Theme.CardBg, TextColor3 = Theme.TextMain }):Play()
    TweenService:Create(UI.keybindStroke, TI.FAST, { Color = Theme.CardBorder }):Play()
    TweenService:Create(UI.ScaleSliderFill, TI.FAST, { BackgroundColor3 = Theme.Accent }):Play()
    TweenService:Create(UI.floatCheckFill, TI.FAST, { BackgroundColor3 = Theme.Accent }):Play()
    TweenService:Create(UI.floatCheckStroke, TI.FAST, { Color = Theme.Accent }):Play()
    TweenService:Create(UI.blurCheckFill, TI.FAST, { BackgroundColor3 = Theme.Accent }):Play()
    TweenService:Create(UI.blurCheckStroke, TI.FAST, { Color = Theme.Accent }):Play()
    TweenService:Create(UI.LogoText, TI.FAST, { TextColor3 = Theme.TextMain }):Play()

    UI.MainScroll.ScrollBarImageColor3 = Theme.Accent
    UI.BindsScroll.ScrollBarImageColor3 = Theme.Accent
    UI.ConfigsScroll.ScrollBarImageColor3 = Theme.Accent
    UI.ThemesScroll.ScrollBarImageColor3 = Theme.Accent

    for id, btn in pairs(UI.TabButtons) do
        local isCurrent = (id == GUI.CurrentTab)
        local targetText = isCurrent and Theme.TextMain or Theme.TextDark
        TweenService:Create(btn, TI.FAST, {
            BackgroundColor3 = isCurrent and Theme.Accent or Theme.TabInactive
        }):Play()
        local icon = btn:FindFirstChild("TabIcon")
        if icon then
            TweenService:Create(icon, TI.FAST, { ImageColor3 = targetText }):Play()
        end
        local title = btn:FindFirstChild("TabTitle")
        if title then
            TweenService:Create(title, TI.FAST, { TextColor3 = targetText }):Play()
        end
    end

    updateBgGradient()

    if GUI.CurrentTab ~= "Configs" and GUI.CurrentTab ~= "Themes" then
        renderFeatureCards(UI.SearchBox.Text)
    end
end

